{
	"name": "react-ansiart",
	"version": "0.3.0",
	"description": "A React component for rendering ANSI art files (.ANS, .ASC) with support for CP437 character encoding, cursor control codes, and progressive animation playback",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./components/*": {
			"import": "./dist/components/*.js",
			"types": "./dist/components/*.d.ts"
		},
		"./generators/*": {
			"import": "./dist/generators/*.js",
			"types": "./dist/generators/*.d.ts"
		},
		"./ansi/*": {
			"import": "./dist/ansi/*.js",
			"types": "./dist/ansi/*.d.ts"
		},
		"./font/*": {
			"import": "./dist/font/*.js",
			"types": "./dist/font/*.d.ts"
		},
		"./utils/*": {
			"import": "./dist/utils/*.js",
			"types": "./dist/utils/*.d.ts"
		},
		"./types/*": {
			"import": "./dist/types/*.js",
			"types": "./dist/types/*.d.ts"
		}
	},
	"sideEffects": false,
	"files": [
		"dist",
		"README.md",
		"AGENTS.md",
		"llms.txt"
	],
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"demo:dev": "concurrently -k -n lib,demo -c blue,green \"npm run dev\" \"npm --prefix demo run dev\"",
		"lint": "eslint src/",
		"test": "node --import tsx --test 'src/**/*.test.ts'",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
		"prepublishOnly": "npm run typecheck && npm test && npm run build",
		"size": "node scripts/check-bundle-size.mjs"
	},
	"keywords": [
		"react",
		"ansi",
		"ansi-art",
		"bbs",
		"terminal",
		"cp437",
		"retro"
	],
	"author": "",
	"license": "MIT",
	"peerDependencies": {
		"react": "^18.0.0 || ^19.0.0"
	},
	"devDependencies": {
		"@types/node": "^22.20.1",
		"@types/react": "^18.2.0",
		"concurrently": "^9.1.0",
		"esbuild": "^0.25.11",
		"eslint": "^9.39.4",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.0.1",
		"tsup": "^8.0.0",
		"tsx": "^4.23.1",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.57.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/benhagen/react-ansiart.git"
	},
	"homepage": "https://github.com/benhagen/react-ansiart#readme",
	"bugs": {
		"url": "https://github.com/benhagen/react-ansiart/issues"
	}
}
